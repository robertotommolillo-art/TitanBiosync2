<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/exerciseNameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold" />

    <!-- Metric filter chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/metricChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipE1rm"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_detail_metric_e1rm"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipWeight"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_detail_metric_weight" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVolume"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_detail_metric_volume" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Range filter chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/rangeChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip30d"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_detail_range_30d" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip90d"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_detail_range_90d" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip365d"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_detail_range_365d" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAll"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_detail_range_all"
            android:checked="true" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Main chart -->
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/progressChart"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="16dp" />

    <!-- No data placeholder -->
    <TextView
        android:id="@+id/noDataText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/chart_no_data"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:alpha="0.6"
        android:visibility="gone" />

</LinearLayout>
